# Copy to .env and fill in. NEVER commit .env.
# All secrets are read server-side only; nothing here is exposed to the browser
# (no NEXT_PUBLIC_ variables are used).

# --- Database ---------------------------------------------------------------
# Inside docker compose the host is the service name "postgres".
POSTGRES_USER=polytrader
POSTGRES_DB=polytrader
POSTGRES_PASSWORD=change-me-long-random
DATABASE_URL=postgres://polytrader:change-me-long-random@postgres:5432/polytrader

# --- AI research --------------------------------------------------------------
ANTHROPIC_API_KEY=

# --- Web / auth -----------------------------------------------------------------
# Public URL of the dashboard (used for cookie + origin checks).
APP_URL=https://trade.simplerecipefinder.com
# Hostname Traefik routes to the web container.
APP_HOSTNAME=trade.simplerecipefinder.com
# 32+ random bytes, e.g. `openssl rand -hex 32`. Used to sign session tokens.
SESSION_SECRET=
# Admin user is created with `npm run create-admin` (prompts for password; only the
# argon2id hash is stored in the database).
ADMIN_EMAIL=

# --- Worker ---------------------------------------------------------------------
# Set to "false" to run the web app without background jobs (e.g. local UI work).
WORKER_ENABLED=true
TZ=UTC
